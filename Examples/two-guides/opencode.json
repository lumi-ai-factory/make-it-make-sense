            "output": 65536
          }
        },
        "nemotron-3.5-lightning-30b-a3b": {
          "name": "Nemotron 3.5 Lightning 30B A3B",
          "tool_call": true,
          "attachment": false,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
